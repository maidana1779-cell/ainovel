{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "alttulpick-api",
  "main": "worker/index.mjs",
  "compatibility_date": "2026-10-19",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "keep_vars": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/health"]
  }
}
